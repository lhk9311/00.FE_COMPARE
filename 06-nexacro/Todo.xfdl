<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Todo" width="1280" height="720" titletext="할 일 CRUD" onload="Todo_onload">
    <Layouts>
      <Layout width="1280" height="720">
        <Static id="sta_title" text="할 일 (Nexacro)" left="20" top="20" width="300" height="34"/>
        <Edit id="edt_title" taborder="0" left="20" top="64" width="300" height="28" onkeyup="edt_title_onkeyup"/>
        <Button id="btn_add" taborder="1" text="추가" left="330" top="64" width="70" height="28" onclick="btn_add_onclick"/>
        <Button id="btn_delete" taborder="2" text="선택 삭제" left="405" top="64" width="80" height="28" onclick="btn_delete_onclick"/>
        <Static id="sta_count" left="20" top="100" width="400" height="24"/>
        <Grid id="grd_todo" taborder="3" left="20" top="128" width="500" height="260" binddataset="ds_todo" autofittype="col" autoenter="select">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="60"/>
                <Column size="440"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="완료"/>
                <Cell col="1" text="할 일"/>
              </Band>
              <Band id="body">
                <Cell displaytype="checkboxcontrol" edittype="checkbox" text="bind:done" checkboxtruevalue="1" checkboxfalsevalue="0"/>
                <Cell col="1" displaytype="editcontrol" edittype="normal" text="bind:title"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_todo" oncolumnchanged="ds_todo_oncolumnchanged">
        <ColumnInfo>
          <Column id="id" type="INT" size="10"/>
          <Column id="title" type="STRING" size="256"/>
          <Column id="done" type="INT" size="1"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="id">1</Col>
            <Col id="title">DOM 개념 정리</Col>
            <Col id="done">1</Col>
          </Row>
          <Row>
            <Col id="id">2</Col>
            <Col id="title">Vite 정리</Col>
            <Col id="done">0</Col>
          </Row>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript6.0"><![CDATA[
/*
  ============================================================
  Nexacro N 화면 파일 (.xfdl = Form 1개)

  [파일 구조]
  - Layouts : 화면 배치. 좌표(left/top/width/height)로 놓는다 (Studio에서 마우스로 그리는 게 기본)
  - Objects : Dataset 정의. Dataset = 메모리 속 테이블 (SI에서 "데이터셋"이라고 하면 이거)
  - Script  : 지금 보고 있는 이 부분. 로직

  [WebSquare와 용어 비교]
  WebSquare        Nexacro
  DataList    ->   Dataset
  gridView    ->   Grid
  submission  ->   transaction()
  scwin.함수  ->   this.함수

  [바인딩]
  - Grid의 binddataset="ds_todo" : 그리드와 데이터셋 연결. 데이터셋 바꾸면 그리드 자동 반영
  - Cell의 text="bind:done"       : 셀과 컬럼 연결 (Vue의 v-model 같은 역할)
  - edittype 지정된 셀은 그리드에서 바로 수정 가능 (= Update 기능)
  - 체크박스: done 컬럼을 INT로 두고 1 = 체크, 0 = 해제
  - trace("...") : 넥사크로의 console.log. Output 창(NRE) 또는 F12 Console(브라우저)에 찍힘
  ============================================================
*/

this.nextId = 3;

// 화면 로드 시 (Vue onMounted 자리)
this.Todo_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	trace("[onload] 화면 로드됨");
	this.fn_updateCount();
};

// ===== Create =====
this.btn_add_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	trace("[추가] 버튼 클릭됨");
	var title = this.edt_title.value;
	trace("[추가] 입력값 = " + title);
	if (!title || title.trim() == "") {
		this.alert("할 일을 입력하세요");
		return;
	}
	var nRow = this.ds_todo.addRow();              // 행 추가 -> 추가된 행 번호
	this.ds_todo.setColumn(nRow, "id", this.nextId++);
	this.ds_todo.setColumn(nRow, "title", title.trim());
	this.ds_todo.setColumn(nRow, "done", 0);
	this.edt_title.set_value("");                  // 속성 변경은 set_속성명() 규칙
	this.fn_updateCount();
};

// 입력창에서 Enter
this.edt_title_onkeyup = function(obj:nexacro.Edit, e:nexacro.KeyEventInfo)
{
	if (e.keycode == 13) this.btn_add_onclick();   // 13 = Enter
};

// ===== Update =====
// 그리드에서 직접 수정 -> Dataset 값이 바뀌면 이 이벤트가 불림
this.ds_todo_oncolumnchanged = function(obj:nexacro.NormalDataset, e:nexacro.DSColChangeEventInfo)
{
	if (e.columnid == "done") this.fn_updateCount();
};

// ===== Delete =====
this.btn_delete_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	var nRow = this.ds_todo.rowposition;           // 현재 선택된 행
	if (nRow < 0) {
		this.alert("삭제할 행을 선택하세요");
		return;
	}
	this.ds_todo.deleteRow(nRow);
	this.fn_updateCount();
};

// 남은 개수 (getCaseCount: 조건에 맞는 행 수. SQL의 COUNT(*) WHERE 같은 것)
this.fn_updateCount = function()
{
	trace("[count] 개수 계산 시작");
	var total = this.ds_todo.rowcount;
	var remain = this.ds_todo.getCaseCount("done != 1");
	this.sta_count.set_text("남은 할 일: " + remain + " / 전체 " + total);
};

/*
  [실무 메모] 서버 통신은 transaction() 한 방으로 한다
  this.transaction(
      "save",                         // 서비스 ID (콜백에서 구분용)
      "svcUrl::todo/save.do",         // 서버 URL (TypeDefinition에 등록한 prefix 사용)
      "input1=ds_todo:U",             // 보낼 Dataset (:U = 변경된 행만, 행 상태 C/U/D 포함)
      "ds_todo=output1",              // 받을 Dataset
      "",                             // 추가 파라미터
      "fn_callback"                   // 완료 콜백
  );
  -> 서버(Spring)에서는 행 상태값 보고 insert/update/delete 분기. WebSquare submission과 같은 패턴
*/
]]></Script>
  </Form>
</FDL>
